# Non-secret settings. Copy to .env (which is gitignored) and adjust.
# Secrets are NOT stored here: they live in secrets/ (see secrets/README.md, `make secrets`).

# Public domain served by Caddy in production (`make up-prod`)
PLATFORM_DOMAIN=vcp.onepercentdata.site

# Database
POSTGRES_DB=platform
POSTGRES_PORT=5432

# Backup (used only when secrets/backup_age_public_key exists, see compose.backup.yaml)
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_LOCAL_DAYS=7
BACKUP_REMOTE=gdrive:platform-backups
BACKUP_RETENTION_REMOTE_DAYS=30

# Source SQL Server (used by the sync worker in a later feature; no service reads these yet).
# Names only, set the values in your local .env and never commit them:
# sql_server_host=
# sql_server_port=
# sql_server_user=
# sql_server_password=
# sql_server_database=
# sql_server_tables=
