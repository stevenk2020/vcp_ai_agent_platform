# HTTPS entry point. Everything is proxied to the api container: /v1/* is the JSON API, every other path is a
# page (sign-in, access request, admin area) or the 404 page, served and gated by the API itself.
{
	# no global options needed; certificates are issued automatically for the site below
}

{$PLATFORM_DOMAIN} {
	# Caddy sets X-Forwarded-For to the real client address (no trusted proxies configured)
	handle /v1/* {
		reverse_proxy api:8000
	}
	handle /healthz {
		respond 200
	}
	handle {
		reverse_proxy api:8000
	}
}

# Internal-only block for the container healthcheck; this port is not published.
:8081 {
	bind 127.0.0.1
	respond /healthz 200
}
